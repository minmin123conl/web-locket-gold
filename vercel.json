{
  "version": 2,
  "builds": [
    {
      "src": "web_app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/web_app.py"
    }
  ],
  "env": {
    "FAKE_RC_URL": "https://locketgold.hoanganh1mw.workers.dev",
    "PYTHONPATH": "/var/task"
  }
}